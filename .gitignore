# The e-course retired 2026-09-01. Its slides live in archive/e-courses so they are kept
# but no longer published, and the two module videos were moved out of the repository
# entirely (../preqal-ecourse-media) because they are the only copies and are ~580MB.
# These guards stay so a rebuilt or re-synced copy can never be committed.
public/e-courses/
**/e-courses/**/*.mp4

# Claude Code worktrees and session data
.claude/

# Internal business documents — never commit
Preqal Website/

# Local secrets — never commit
.env.secrets
~$*

# Playwright artifacts
test-results/
playwright-report/

# ux-skill (local design-engine state and plugin marker; the engine lives on this Mac, not in CI)
.ux/
.claude-plugin/

# /brag output: a 2MB render plus a third-party music track whose licence the
# bundling skill says is unverified. Kept out of a public repo until it is.
brag-output/

# Blog review state: local runtime, written by the scheduled runs.
# A stale "awaiting" committed into a fresh checkout would wedge the weekly
# task behind a review that cannot complete.
content/blog/runs/review-state.json
